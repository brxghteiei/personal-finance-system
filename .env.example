# Supabase Auth and project API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# One-time existing-user import only. Never expose this key in client code or Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# PostgreSQL connection. Use a development database, never production credentials here.
DATABASE_URL=

# Public origin for email links and same-origin request validation.
APP_URL=http://localhost:3000

# Generate at least 32 random bytes with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# SMTP delivery settings
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Cloudflare Turnstile is required after login attempts are challenged.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

NEXT_PUBLIC_APP_NAME="Personal Finance System"
