generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  INCOME
  EXPENSE
}

model Category {
  id           String        @id @default(cuid())
  name         String
  type         TransactionType
  isActive     Boolean       @default(true)
  ownerId      String?       @map("owner_id")
  owner        User?         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([ownerId, name, type])
  @@index([type])
  @@index([ownerId])
}

model Transaction {
  id         String          @id @default(cuid())
  title      String
  amount     Decimal        @db.Decimal(12, 2)
  type       TransactionType
  date       DateTime
  time       String          @default("12:00") @db.VarChar(5)
  note       String?
  categoryId String
  category   Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  ownerId    String?         @map("owner_id")
  owner      User?           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  deletedAt  DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([date])
  @@index([type, date])
  @@index([categoryId])
  @@index([deletedAt])
  @@index([ownerId, date])
}

model Budget {
  id           String   @id @default(cuid())
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  ownerId      String?  @map("owner_id")
  owner        User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  month        DateTime @db.Date
  budgetAmount Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([categoryId, month])
  @@index([month])
  @@index([ownerId, month])
}

model User {
  id                    String                   @id @default(cuid())
  email                 String                   @unique @db.VarChar(254)
  name                  String                   @db.VarChar(100)
  passwordHash          String?                  @map("password_hash")
  authUserId            String?                  @unique @map("auth_user_id") @db.Uuid
  emailVerifiedAt       DateTime?                @map("email_verified_at")
  termsAcceptedAt       DateTime                 @map("terms_accepted_at")
  termsVersion          String                   @map("terms_version") @db.VarChar(32)
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")
  sessions              Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens   PasswordResetToken[]
  categories            Category[]
  transactions          Transaction[]
  budgets               Budget[]

  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  tokenHash    String   @unique @map("token_hash") @db.Char(64)
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastSeenAt   DateTime @default(now()) @map("last_seen_at")
  expiresAt    DateTime @map("expires_at")
  rememberMe   Boolean  @default(false) @map("remember_me")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId, expiresAt])
  @@map("sessions")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model LoginAttempt {
  id              String    @id @default(cuid())
  scope           String    @db.VarChar(16)
  keyHash         String    @map("key_hash") @db.Char(64)
  failureCount    Int       @default(0) @map("failure_count")
  lockoutLevel    Int       @default(0) @map("lockout_level")
  blockedUntil    DateTime? @map("blocked_until")
  firstFailureAt  DateTime  @default(now()) @map("first_failure_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([scope, keyHash])
  @@index([blockedUntil])
  @@map("login_attempts")
}
